{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "npm test && npm run build && npm run check",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work/nu-labs-identity/",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/work/studio-index/",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/work/open-house/",
      "destination": "/work/",
      "permanent": true
    }
  ]
}
